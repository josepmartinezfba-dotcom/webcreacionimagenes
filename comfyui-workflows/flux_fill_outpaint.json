{
  "1": {
    "class_type": "UnetLoaderGGUF",
    "inputs": {
      "unet_name": "flux1-fill-dev-Q4_K_S.gguf"
    },
    "_meta": { "title": "UNET Loader GGUF (Modelo FLUX Fill Q4_K_S)" }
  },
  "2": {
    "class_type": "DualCLIPLoader",
    "inputs": {
      "clip_name1": "clip_l.safetensors",
      "clip_name2": "t5xxl_fp8_e4m3fn.safetensors",
      "type": "flux"
    },
    "_meta": { "title": "Dual CLIP Loader" }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "ae.safetensors"
    },
    "_meta": { "title": "VAE Loader" }
  },
  "4": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "canvas.png"
    },
    "_meta": { "title": "Imagen de entrada (lienzo expandido)" }
  },
  "5": {
    "class_type": "LoadImageMask",
    "inputs": {
      "image": "mask.png",
      "channel": "red"
    },
    "_meta": { "title": "Mascara de outpainting" }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "high quality illustration, consistent art style, seamless continuation of background, matching lighting and perspective",
      "clip": ["2", 0]
    },
    "_meta": { "title": "Prompt positivo" }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "blurry, distorted, low quality, seams, visible border, mismatched style, watermark, text, extra objects",
      "clip": ["2", 0]
    },
    "_meta": { "title": "Prompt negativo" }
  },
  "8": {
    "class_type": "FluxGuidance",
    "inputs": {
      "guidance": 30,
      "conditioning": ["6", 0]
    },
    "_meta": { "title": "Guidance FLUX" }
  },
  "9": {
    "class_type": "InpaintModelConditioning",
    "inputs": {
      "positive": ["8", 0],
      "negative": ["7", 0],
      "vae": ["3", 0],
      "pixels": ["4", 0],
      "mask": ["5", 0],
      "noise_mask": true
    },
    "_meta": { "title": "Inpaint Model Conditioning" }
  },
  "10": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["1", 0],
      "positive": ["9", 0],
      "negative": ["9", 1],
      "latent_image": ["9", 2],
      "seed": 0,
      "steps": 20,
      "cfg": 1,
      "sampler_name": "euler",
      "scheduler": "normal",
      "denoise": 1
    },
    "_meta": { "title": "KSampler (Muestreador)" }
  },
  "11": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["10", 0],
      "vae": ["3", 0]
    },
    "_meta": { "title": "VAE Decode" }
  },
  "12": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["11", 0],
      "filename_prefix": "outpaint"
    },
    "_meta": { "title": "Guardar imagen resultado" }
  }
}
